# Public domain served by Traefik (DNS A/AAAA record pointing to the VPS).
DOMAIN=ai-inspector.example.com
# Docker network Traefik is attached to (`docker network ls`).
TRAEFIK_NETWORK=traefik-public
# Traefik HTTPS entrypoint and certificate resolver names (from Traefik's config).
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
