# Copy to .env and adjust. Every value has a working default for local dev.

ENVIRONMENT=development

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for extra origins (e.g. Netlify deploy previews):
# CORS_ORIGIN_REGEX=https://.*--your-site\.netlify\.app

# SQLite (zero-config, default) or Postgres. A plain postgres:// or
# postgresql:// URL (as given by Neon) is accepted and mapped to psycopg 3.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./ai_inspector.db
